{
  "name": "ledger-invariants",
  "version": "0.1.0",
  "description": "A double-entry ledger in Postgres where an unbalanced entry is impossible, history is append-only, posting is idempotent, and protected accounts can't go negative under concurrent writes.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ledger",
    "double-entry",
    "postgres",
    "accounting",
    "payments",
    "invariants"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "fast-check": "^3.23.2",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderinho2/ledger-invariants.git"
  },
  "homepage": "https://github.com/coderinho2/ledger-invariants#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
